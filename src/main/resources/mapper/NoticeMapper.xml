<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.minbak.web.notice.NoticeMapper">

    <insert id="insertNotice" parameterType="com.minbak.web.notice.NoticeDto" useGeneratedKeys="true" keyProperty="noticeId">
        INSERT INTO notice (user_id, title, content, created_at)
        VALUES (#{userId}, #{title}, #{content}, NOW())
    </insert>

    <!-- 공지사항 목록 조회 -->
    <select id="getNoticeList" resultType="com.minbak.web.notice.NoticeDto">
        SELECT notice_id, user_id, title, created_at FROM notice ORDER BY created_at DESC
    </select>
    <!-- 공지사항 상세 조회 -->

    <select id="getNoticeById" parameterType="int" resultType="com.minbak.web.notice.NoticeDto">
        SELECT * FROM notice WHERE notice_id = #{noticeId}
    </select>
</mapper>